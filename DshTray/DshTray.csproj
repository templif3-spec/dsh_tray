<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>DshTray</AssemblyName>
    <RootNamespace>DshTray</RootNamespace>
    <ApplicationIcon>deepseek.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <FileVersion>1.0.0.0</FileVersion>
    <InformationalVersion>1.0.0</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <AssemblyTitle>DshTray</AssemblyTitle>
    <Product>DshTray</Product>
    <Description>DeepSeek Harness 服务托盘管理程序</Description>
    <Copyright>© 2026</Copyright>
    <Company>DshTray</Company>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="deepseek.ico" LogicalName="DshTray.deepseek.ico" />
  </ItemGroup>

</Project>
